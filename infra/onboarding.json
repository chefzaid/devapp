{
  "version": 2,
  "application": "infra/argocd/application.yaml",
  "inputs": [
    {
      "name": "APP_SUBDOMAIN",
      "label": "Public subdomain (@ for the zone apex)",
      "type": "subdomain",
      "default": "devapp"
    }
  ],
  "files": [
    ".gitlab-ci.yml",
    ".github/workflows/sync-gitlab.yml",
    "sonar-project.properties",
    "infra/argocd/application.yaml",
    "infra/k8s/kustomization.yaml",
    "infra/k8s/ingress.yaml",
    "infra/scripts/configure-gitlab.sh",
    "infra/scripts/configure-code-quality.sh",
    "infra/scripts/configure-repository-sync.sh",
    "infra/k8s/user.yaml",
    "infra/k8s/order.yaml",
    "infra/k8s/web.yaml",
    "infra/keycloak/production-client.json",
    "infra/scripts/configure-keycloak.py",
    "infra/k8s/backend-runtime.properties",
    "infra/k8s/web-runtime-config.json"
  ],
  "replacements": [
    {
      "from": "registry.swirlit.dev/swirlit/devapp",
      "to": "{{REGISTRY_HOST}}/{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "https://gitlab.swirlit.dev/swirlit/devapp",
      "to": "{{GITLAB_PUBLIC_URL}}/{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "http://gitlab.swirlit.internal/swirlit/devapp",
      "to": "{{GITLAB_INTERNAL_URL}}/{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "https://gitlab.swirlit.dev",
      "to": "{{GITLAB_PUBLIC_URL}}"
    },
    {
      "from": "http://gitlab.swirlit.internal",
      "to": "{{GITLAB_INTERNAL_URL}}"
    },
    {
      "from": "gitlab-registry.swirlit.internal:5050",
      "to": "{{REGISTRY_PUSH_HOST}}"
    },
    {
      "from": "registry.swirlit.dev",
      "to": "{{REGISTRY_HOST}}"
    },
    {
      "from": "devapp.swirlit.dev",
      "to": "{{APP_HOST}}"
    },
    {
      "from": "keycloak.swirlit.dev",
      "to": "keycloak.{{PUBLIC_DOMAIN}}"
    },
    {
      "from": "sonarqube.swirlit.dev",
      "to": "sonarqube.{{PUBLIC_DOMAIN}}"
    },
    {
      "from": ".swirlit.internal",
      "to": ".{{INTERNAL_DNS_ZONE}}"
    },
    {
      "from": "swirlit-dev-tls",
      "to": "{{TLS_SECRET_NAME}}"
    },
    {
      "from": "swirlit:devapp",
      "to": "{{SONAR_PROJECT_KEY}}"
    },
    {
      "from": "swirlit/devapp",
      "to": "{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "swirlit/$APP_NAME",
      "to": "{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "swirlit/$REPOSITORY_NAME",
      "to": "{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "swirlit:$APP_NAME",
      "to": "{{SONAR_PROJECT_KEY}}"
    },
    {
      "from": "GITLAB_PROJECT_ID: '1'",
      "to": "GITLAB_PROJECT_ID: '{{GITLAB_PROJECT_ID}}'"
    },
    {
      "from": "/realms/swirlit",
      "to": "/realms/{{KEYCLOAK_REALM}}"
    },
    {
      "from": "@swirlit.dev",
      "to": "@{{PUBLIC_DOMAIN}}"
    },
    {
      "from": "GITHUB_OWNER=\"${GITHUB_OWNER:-chefzaid}\"",
      "to": "GITHUB_OWNER=\"${GITHUB_OWNER:-{{GITHUB_OWNER}}}\""
    },
    {
      "from": "GITHUB_REPOSITORY=\"${GITHUB_REPOSITORY:-$REPOSITORY_NAME}\"",
      "to": "GITHUB_REPOSITORY=\"${GITHUB_REPOSITORY:-{{GITHUB_REPOSITORY}}}\""
    },
    {
      "from": "default=\"swirlit\"",
      "to": "default=\"{{KEYCLOAK_REALM}}\""
    },
    {
      "from": "DB_HOST=postgres.swirlit.internal",
      "to": "DB_HOST=postgres.{{INTERNAL_DNS_ZONE}}"
    },
    {
      "from": "KAFKA_BOOTSTRAP_SERVERS=kafka.swirlit.internal:9092",
      "to": "KAFKA_BOOTSTRAP_SERVERS=kafka.{{INTERNAL_DNS_ZONE}}:9092"
    },
    {
      "from": "REDIS_HOST=redis.swirlit.internal",
      "to": "REDIS_HOST=redis.{{INTERNAL_DNS_ZONE}}"
    },
    {
      "from": "JWT_ISSUER_URI=https://keycloak.swirlit.dev/auth/realms/swirlit",
      "to": "JWT_ISSUER_URI=https://keycloak.{{PUBLIC_DOMAIN}}/auth/realms/{{KEYCLOAK_REALM}}"
    },
    {
      "from": "JWT_JWK_SET_URI=http://keycloak.swirlit.internal:8080/auth/realms/swirlit/protocol/openid-connect/certs",
      "to": "JWT_JWK_SET_URI=http://keycloak.{{INTERNAL_DNS_ZONE}}:8080/auth/realms/{{KEYCLOAK_REALM}}/protocol/openid-connect/certs"
    },
    {
      "from": "CORS_ALLOWED_ORIGINS=https://devapp.swirlit.dev",
      "to": "CORS_ALLOWED_ORIGINS=https://{{APP_HOST}}"
    },
    {
      "from": "\"keycloakUrl\": \"https://keycloak.swirlit.dev/auth\"",
      "to": "\"keycloakUrl\": \"https://keycloak.{{PUBLIC_DOMAIN}}/auth\""
    },
    {
      "from": "\"keycloakRealm\": \"swirlit\"",
      "to": "\"keycloakRealm\": \"{{KEYCLOAK_REALM}}\""
    }
  ],
  "registry": {
    "path": "apps/devapp/registry"
  },
  "keycloak": {
    "file": "infra/keycloak/production-client.json",
    "realm": "{{KEYCLOAK_REALM}}"
  },
  "dns": {
    "hosts": [
      "{{APP_HOST}}"
    ]
  },
  "pipeline": {
    "variables": {
      "APP_ONBOARDING": "true"
    },
    "jobs": [
      "01-release",
      "02-deploy"
    ]
  },
  "readiness": {
    "deployments": [
      "user-app",
      "order-app",
      "devapp-web"
    ]
  },
  "deployment": {
    "inventory": "infra/deployment-environments.json",
    "settingsDirectory": "infra/environments",
    "defaultEnvironment": "int",
    "dataServices": [
      "postgres",
      "redis",
      "kafka"
    ]
  }
}
